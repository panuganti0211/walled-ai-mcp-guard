.env.*

# Runtime audit logs and test sandboxes
logs/*.log
logs/*.jsonl
logs/*.json
!logs/.gitkeep
sandbox_files/
tmp_test_sandbox/

# IDE / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
